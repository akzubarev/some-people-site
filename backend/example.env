DEBUG=1
POSTGRES_USER=residual
POSTGRES_PORT=5432
API_URL=http://v1.admin.some-people.localhost:1337

POSTGRES_DB=database
POSTGRES_PASSWORD=password
POSTGRES_HOST=postgresql

SECRET_KEY=kek
DOMAINS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8083
CSRF_COOKIE_SECURE=0
SESSION_COOKIE_SECURE=0
TRUST_X_FORWARDED_PROTO=0
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL="admin@admin.com"
DJANGO_SUPERUSER_PASSWORD="admin"

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

CELERY_BROKER_URL=redis
CELERY_RESULT_BACKEND=

MAIN_SITE_ID=1
COMPANY_ID=1
TIME_ZONE='Europe/Moscow'

# Local media is the default. Set s3 only after copying and verifying existing files.
MEDIA_STORAGE=local
# OCI S3 compatibility endpoint (copy the exact endpoint for your namespace/region).
MEDIA_S3_ENDPOINT_URL=https://namespace.compat.objectstorage.region.oraclecloud.com
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
# OCI Customer Secret Key pair; never put real values in this file.
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Optional object prefix; existing database file names stay unchanged.
MEDIA_S3_PREFIX=
MEDIA_S3_URL_TTL=3600
